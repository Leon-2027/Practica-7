public class Empleado {
    protected String nombre;
    protected int ID;
    protected double salario;
    private int EXP;
   
    public Empleado (String nombre, int ID, double salario, int EXP){
        this.salario=salario;
        this.nombre=nombre;
        this.ID=ID;
        this.EXP=EXP;
    }
   
    @Override
    public String toString(){
        return "Nombre: " + nombre + " | Experiencia: " + EXP + " | ID: " + ID + " |Salario Base: " + salario;
    }
}
